{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "//": "Single-page app: every route must serve index.html, or a refresh on /login returns 404.",
      "source": "/((?!screenshots/|brand-preview.png).*)",
      "destination": "/index.html"
    }
  ]
}
